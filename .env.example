# Token de tu Bot en Discord Developer Portal
DISCORD_TOKEN=tu_token_aqui

# Client ID (Application ID) de tu aplicación de Discord
CLIENT_ID=tu_client_id_aqui

# (Opcional) Guild ID de pruebas para registrar Slash Commands al instante
GUILD_ID=

# Prefijo clásico por defecto (estilo época dorada)
DEFAULT_PREFIX=c!

# ID del creador del bot
OWNER_ID=

# (Opcional) Credenciales de Spotify Web API (https://developer.spotify.com/dashboard)
# Si se dejan vacías, el bot usará automáticamente el extractor público de Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
